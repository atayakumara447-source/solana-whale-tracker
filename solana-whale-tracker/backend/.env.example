# Salin file ini menjadi ".env" lalu isi dengan nilai aslimu.
# JANGAN pernah commit file ".env" yang berisi kredensial asli ke Git.

# Konfigurasi server
PORT=5000

# Konfigurasi Solscan API
SOLSCAN_API_KEY=isi_dengan_api_key_solscan_kamu
SOLSCAN_BASE_URL=https://pro-api.solscan.io/v2.0

# Ambang batas jumlah SOL untuk dianggap transaksi "whale"
WHALE_THRESHOLD_SOL=1000

# Konfigurasi database PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=isi_dengan_password_db_kamu
DB_NAME=solana_whale_tracker
